# ResolveAI reverse proxy.
#
# Caddy terminates TLS (auto-provisioned and auto-renewed from Let's Encrypt for
# $DOMAIN) and proxies the public site to the Streamlit frontend. The API and
# every datastore stay on the internal Docker network with no public route. The
# browser talks to Streamlit, which calls the private HTTPS listener below.
#
# $DOMAIN and $ACME_EMAIL are injected from .env.production.
{
	email {$ACME_EMAIL}
}

# Both HTTPS listeners use this hostname; the public HTTP redirect must always
# select port 443, never the private API port.
http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 308
}

{$DOMAIN} {
	encode zstd gzip
	# Streamlit's live updates run over WebSockets; reverse_proxy upgrades them
	# transparently, so no extra config is needed here.
	reverse_proxy frontend:8501
}

# Only reachable inside Compose: port 8443 is not published on the host. The
# DOMAIN network alias resolves to this container; hostname validation and the
# publicly trusted certificate for DOMAIN remain intact. Secure refresh cookies
# can now travel from Streamlit's HTTP client without disabling TLS verification.
https://{$DOMAIN}:8443 {
	reverse_proxy api:8000
}
