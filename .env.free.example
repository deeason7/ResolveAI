# ResolveAI — all-free (managed-tier) environment template.
#
# Backend env for the Hugging Face Space: the API and BOTH stream workers run
# there in one container (see the root Dockerfile). On HF you don't keep this
# file — paste each KEY=VALUE into the Space's Settings → "Variables and
# secrets". Locally you can:
#
#   cp .env.free.example .env.free      # then fill in; .env.free is git-ignored
#
# Each backing service is a free, no-credit-card managed tier. Generate each JWT
# secret as its own fresh string:  openssl rand -hex 32
#
# Frontend config (Streamlit Community Cloud) is separate — see
# .streamlit/secrets.toml.example.

# --- PostgreSQL → Neon (free ~0.5 GB) ---
# Neon hands you: postgresql://USER:PWD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
# Use the asyncpg driver and DROP the ?sslmode= query — asyncpg ignores it, so
# DB_REQUIRE_SSL applies TLS via the engine's connect_args instead.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/dbname
DB_REQUIRE_SSL=true

# --- Redis → Upstash (free 500K commands/month) ---
# Upstash gives a rediss:// URL; redis.asyncio turns on TLS from the scheme, so
# keep the second "s". No extra flag needed.
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379
# Free-tier poll cadence — widen the block and thin the PEL sweep so the two
# idle workers stay under 500K cmds/month (≈ 200K at these values). Local dev
# leaves these unset and keeps the snappy 5000 / every-cycle defaults.
WORKER_BLOCK_MS=30000
WORKER_RECLAIM_EVERY=4

# --- Qdrant → Qdrant Cloud (free 1 GB) ---
QDRANT_URL=https://xxxxxxxx.REGION.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# --- Neo4j → Aura Free ---
# neo4j+s:// is TLS bolt. Aura ships APOC Core, which is all the graph code
# needs (apoc.path.subgraphAll in graph_store.py).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_aura_password_here
# Aura names its database after the instance id (the URI subdomain), NOT
# "neo4j". Read it from the Aura console or `SHOW DATABASES`. The app/seed
# default "neo4j" only fits Community/Docker, so set it explicitly here.
NEO4J_DATABASE=your_aura_instance_id

# --- LLM → Groq (free tier) ---
# No local SLM on free hosting — classify straight through Groq.
LLM_SKIP_LOCAL=true
GROQ_API_KEY=your_groq_api_key_here

# --- Auth (two DIFFERENT long random strings: openssl rand -hex 32) ---
JWT_SECRET_KEY=__change_me__
JWT_REFRESH_SECRET_KEY=__change_me_differently__

# --- App ---
# production keeps CORS closed: the Streamlit frontend calls the API server-side,
# never from the browser, so there's no cross-origin request to allow.
ENVIRONMENT=production
LOG_LEVEL=INFO
