# ResolveAI — production environment template.
#
#   cp .env.production.example .env.production   # then fill in the blanks
#
# The filled .env.production is git-ignored — never commit it. Generate every
# password and secret below as its own fresh random string:
#
#   openssl rand -hex 32
#
# Labeling-only settings (OPENAI_API_KEY, AWS_REGION) are intentionally left
# out — fine-tuning/label engineering is a dev-time job, not part of hosting.

# --- Public domain ---
# Point an A record at the server's public IP BEFORE bringing Caddy up, or the
# TLS challenge fails. Caddy reads both of these to provision + renew the cert.
DOMAIN=resolveai.example.com
ACME_EMAIL=you@example.com

# --- Database ---
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=__change_me__
POSTGRES_DB=resolveai_db
# The password in DATABASE_URL must stay identical to POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://resolveai:__change_me__@postgres:5432/resolveai_db

# --- Redis ---
REDIS_PASSWORD=__change_me__
# The password in REDIS_URL must stay identical to REDIS_PASSWORD above.
REDIS_URL=redis://:__change_me__@redis:6379/0

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=__change_me__
NEO4J_URI=bolt://neo4j:7687
# The neo4j *server* reads its credentials from this one combined var; keep it
# as "<NEO4J_USER>/<NEO4J_PASSWORD>" with the exact values above.
NEO4J_AUTH=neo4j/__change_me__

# --- LLM routing ---
# True = skip the local Ollama SLM and classify straight through Groq's free
# tier. That's the right default for ARM / low-RAM hosts that can't serve the
# 3B model. Set false ONLY if you also bring up the `local-llm` compose profile.
LLM_SKIP_LOCAL=true
GROQ_API_KEY=your_groq_api_key_here
# Only consulted when the local-llm profile is running:
OLLAMA_BASE_URL=http://ollama:11434

# --- Auth (two DIFFERENT long random strings) ---
JWT_SECRET_KEY=__change_me__
JWT_REFRESH_SECRET_KEY=__change_me_differently__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
# production keeps CORS closed: the browser never calls the API cross-origin,
# only the Streamlit server does, over the internal network.
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend ---
# The Streamlit container reaches the API over the compose network; the default
# (http://api:8000) is already correct, so leave API_URL unset. Override the
# shared demo credentials if you don't want the built-in defaults.
# API_URL=http://api:8000
# DEMO_EMAIL=demo@resolveai-demo.com
# DEMO_PASSWORD=change-this-demo-password
