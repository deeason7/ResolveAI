# --- Database ---
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=resolveai_db
DATABASE_URL=postgresql+asyncpg://resolveai:changeme@postgres:5432/resolveai_db

# --- Redis ---
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434

# --- LLM (cloud fallback) ---
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_REFRESH_SECRET_KEY=change_this_to_a_different_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
