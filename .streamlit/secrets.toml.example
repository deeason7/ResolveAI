# Streamlit Community Cloud secrets for the ResolveAI dashboard.
#
# Do NOT commit the real .streamlit/secrets.toml (it's git-ignored). Instead,
# paste these top-level keys into the app's Settings → Secrets on Streamlit
# Cloud. Streamlit exposes TOP-LEVEL keys as environment variables, which is how
# api_client.py's os.environ.get("API_URL") reaches the backend.

# Public URL of the Hugging Face Space running the API (no trailing slash).
API_URL = "https://your-space.hf.space"

# Optional — override the built-in shared demo account (recruiters/visitors).
# DEMO_EMAIL = "demo@resolveai-demo.com"
# DEMO_PASSWORD = "change-this-demo-password"
